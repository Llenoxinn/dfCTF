# Copy to .env.local for local development. Never commit populated environment files.
APP_URL=http://127.0.0.1:3000

# Local development uses one embedded PGlite database when DATABASE_URL is empty.
# Set a PostgreSQL connection string for production or multi-process development.
DATABASE_URL=

# Generate separate random secrets for every deployed environment, at least 32 characters each.
# Empty values are permitted only by the local development configuration.
AUTH_SECRET=
FLAG_SECRET=

# Development only: messages are written to .data/mail rather than sent.
LOCAL_MAIL=1
SMTP_URL=
MAIL_FROM=dfCTF <noreply@example.test>

# Google/GitHub buttons appear only when both values for that provider are configured.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Private artifact storage. Production must persist this path across app replacements.
ARTIFACT_DIR=.data/artifacts

# Used by compose.yaml, not the embedded local database.
POSTGRES_DB=dfctf
POSTGRES_USER=dfctf
POSTGRES_PASSWORD=
