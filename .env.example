# Copy to .env.local for local development. Never commit populated environment files.
APP_URL=http://127.0.0.1:3000

# Local development uses one embedded PGlite database when DATABASE_URL is empty.
# Set a PostgreSQL connection string for production or multi-process development.
DATABASE_URL=
# Optional direct/session PostgreSQL connection for CLI migrations; defaults to DATABASE_URL.
# Supabase is a PostgreSQL host here. Do not put a browser anon key in either value.
DATABASE_MIGRATION_URL=

# Generate separate random secrets for every deployed environment, at least 32 characters each.
# Empty values are permitted only by the local development configuration.
AUTH_SECRET=
FLAG_SECRET=

# Development only: messages are written to .data/mail rather than sent.
LOCAL_MAIL=1
SMTP_URL=
MAIL_FROM=dfCTF <noreply@example.test>

# Social sign-in buttons are enabled when both values for that provider are configured.
# Register the exact APP_URL callback on each provider; see docs/OAUTH.md.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Local artifact backup copies and fallback for older file-only records.
# Vercel always uses database-only storage. Set 0 on other hosts without a private disk.
# Backfill legacy file-only records before disabling copies; keep database backups.
ARTIFACT_LOCAL_BACKUP=1
ARTIFACT_DIR=.data/artifacts

# Used by compose.yaml, not the embedded local database.
POSTGRES_DB=dfctf
POSTGRES_USER=dfctf
POSTGRES_PASSWORD=
